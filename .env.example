APP_NAME="Court Booking System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=court_booking
DB_USERNAME=root
DB_PASSWORD=

# --- Session / Cache / Queue ---
# File/sync drivers keep the database limited to the four domain tables
# (users, courts, court_slots, bookings) + Sanctum's personal_access_tokens.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Mail ---
# `log` writes booking notification emails to storage/logs/laravel.log
# (no SMTP credentials needed for the demo). Swap to smtp in production.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@courtbooking.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sanctum ---
SANCTUM_STATEFUL_DOMAINS=localhost
SANCTUM_TOKEN_EXPIRATION=

# --- Slot generation ---
# Default days ahead that "generate-slots" produces when no end_date/days is given.
SLOT_GENERATION_HORIZON_DAYS=30

# --- Default admin (created by AdminUserSeeder) ---
ADMIN_EMAIL=admin@courtbooking.test
ADMIN_PASSWORD=Password123!
